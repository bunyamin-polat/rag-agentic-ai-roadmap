# Optional settings. Copy this file to `.env` to change them:  cp .env.example .env

# Any chat model you have pulled with `ollama pull <name>`.
# CHAT_MODEL=gpt-oss:20b

# Where the Ollama server runs.
# OLLAMA_HOST=http://localhost:11434

# Optional: a Hugging Face token only makes model and dataset downloads faster.
# Create one at https://huggingface.co/settings/tokens (read access is enough).
# HF_TOKEN=
